---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Personal Website',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Hero tagline="" actions={[{ variant: 'primary', text: 'Read my CV', href: getPermalink('/cv') }]}>
    <Fragment slot="title"> Hi, I'm <span class="text-accent dark:text-white">Henrik</span> </Fragment>
    <Fragment slot="subtitle">
      I'm a research scientist specialising in sleek, pragmatic and efficient solutions to really, really (really)
      complex problems.
    </Fragment>
  </Hero>
</Layout>
